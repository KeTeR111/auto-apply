# ════════════════════════════════════════════════════
#  hh.ru Авто-отклик — конфигурация
# ════════════════════════════════════════════════════

# ── Аккаунт hh.ru ───────────────────────────────────
# Email аккаунта hh.ru
HH_EMAIL=

# Пароль аккаунта hh.ru
HH_PASSWORD=

# ── AI модель ────────────────────────────────────────
# Адрес AI сервера
AI_BASE_URL=http://localhost:11434/v1

# Название модели
AI_MODEL=qwen2.5:14b

# API ключ (для Ollama — любое значение)
AI_API_KEY=ollama

# OpenRouter (раскомментировать для переключения на API)
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=anthropic/claude-sonnet-4-5
# AI_API_KEY=

# ── Параметры поиска ────────────────────────────────
# Поисковые запросы через ;
SEARCH_QUERIES=Аналитик данных;Data Analyst;BI аналитик;Junior Data Analyst;Аналитик Python;Стажер аналитик;Младший аналитик;Аналитик отчетности;Аналитик SQL;Работа с данными;Стажер Data Analyst

# Код региона (1=Москва, 2=СПб, 113=вся Россия)
AREA=1

# Фильтр по минимальной зарплате (пусто = без фильтра)
SALARY_FROM=

# ── Фильтры ─────────────────────────────────────────
# Исключаемые компании через ;
COMPANY_EXCLUDE=сбер;sber

# Фильтры опыта в порядке приоритета через ;
# noExperience | between1And3 | between3And6 | moreThan6
EXPERIENCE_PASSES=noExperience;between1And3

# ── Параметры системы ───────────────────────────────
# Максимум откликов в день
DAILY_LIMIT=200

# Минимальная оценка релевантности для отклика (0.0–1.0)
MIN_SCORE=0.65

# Сохранять каждое N-е сопроводительное в папку covers/
SAVE_COVER_EVERY=1